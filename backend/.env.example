# Application
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_platform

# Redis
REDIS_URL=redis://localhost:6379

# Unipile
UNIPILE_API_KEY=your-unipile-api-key
UNIPILE_ACCOUNT_ID=your-unipile-account-id
UNIPILE_WEBHOOK_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Claude AI
CLAUDE_API_KEY=your-claude-api-key

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn mode
LINKEDIN_MODE=unipile

# Admin (used by db:seed — no default values, must be set explicitly)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_INITIAL_PASSWORD=

# Dashboard
DASHBOARD_URL=http://localhost:5173

# Resend (optional email notifications)
RESEND_API_KEY=
