# Application
NODE_ENV=development
PORT=3001

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linkedin_platform

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# Unipile
UNIPILE_API_KEY=your-unipile-api-key
UNIPILE_ACCOUNT_ID=your-unipile-account-id
UNIPILE_WEBHOOK_SECRET=change-me-to-a-random-string-of-at-least-32-characters
UNIPILE_BASE_URL=https://api.unipile.com

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_SERVICE_TIER=auto

# LinkedIn mode
LINKEDIN_MODE=unipile

# Admin (used by db:seed — must be set before seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# Dashboard (frontend URL for CORS — matches Vite dev server port)
DASHBOARD_URL=http://localhost:3000

# Telegram (optional — daily/sunday reports)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (optional — email notifications)
RESEND_API_KEY=
